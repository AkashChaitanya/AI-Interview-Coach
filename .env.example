# Copy this file to .env and configure at least one cloud provider for interview
# feedback and AI-based scoring. Groq is tried first when configured.
# Candidate answers and questions are sent to the configured cloud provider.
# Provider quotas, pricing, and availability are controlled by each provider.

GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Optional OpenAI-compatible endpoint. API keys stay on the backend.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_MODEL=gemini-2.0-flash

# Local Ollama is not used as a fallback for required cloud interview scoring.
OLLAMA_HOST=http://localhost:11434
OLLAMA_ENABLED=false
OLLAMA_MODEL=llama3

# Optional comma-separated browser origins for cross-origin development.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
